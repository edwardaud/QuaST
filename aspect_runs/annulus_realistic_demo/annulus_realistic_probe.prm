# The realistic-card-on-the-annulus ASPECT pilot: probe card.
#
# Identical to annulus_realistic_pilot.prm except for the two lines that make it
# a parameter/mesh probe rather than an integration: End time = 1e-3 s (one
# step) and one VTU output at t = 0.  Purpose: prove that the pinned image
# parses the function initial condition (muparser atan2/ln), loads the plugin,
# builds the annular shell mesh and reports the cell counts -- before spending
# the pilot's wall clock.  Generated by the campaign (not hand-maintained).
set Dimension                              = 2
set Use years in output instead of seconds = false
set End time                               = 1e-3
set CFL number                             = 0.5
set Maximum time step                      = 4.2e14
set Output directory                       = output-annulus-realistic-probe
set Pressure normalization                 = surface
set Surface pressure                       = 0
set Additional shared libraries            = /work/build/librealistic_composite.release.so
set Nonlinear solver scheme                = single Advection, single Stokes

subsection Geometry model
  set Model name = spherical shell
  subsection Spherical shell
    set Inner radius  = 3538000
    set Outer radius  = 6438000
    set Opening angle = 360
  end
end

subsection Nullspace removal
  set Remove nullspace = net rotation
end

subsection Initial temperature model
  set Model name = function
  subsection Function
    set Variable names      = x,z
    set Function constants  = d=2.9e6, dT=1000, pi=3.141592653589793, H=10, A1=0.05, A2=0.02, R0=1.22, R1=2.22
    set Function expression = 500 + dT*((1 - 0.25*H*(R1^2-R0^2))*ln(R1/sqrt((x/d)^2+(z/d)^2))/ln(R1/R0) + 0.25*H*(R1^2 - ((x/d)^2+(z/d)^2)) + A1*sin(pi*(sqrt((x/d)^2+(z/d)^2)-R0))*cos(2*atan2(z,x)) + A2*sin(2*pi*(sqrt((x/d)^2+(z/d)^2)-R0))*cos(4*atan2(z,x)))
  end
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = 0,1
  set List of model names = spherical constant
  subsection Spherical constant
    set Inner temperature = 1500
    set Outer temperature = 500
  end
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = 0,1
end

subsection Gravity model
  set Model name = radial constant
  subsection Radial constant
    set Magnitude = 9.81
  end
end

set Adiabatic surface temperature = 500
subsection Adiabatic conditions model
  set Model name = function
  subsection Function
    set Variable names      = depth
    set Function constants  = rho=3300, g=9.81, T0=500
    set Function expression = T0; rho*g*depth; rho
  end
end

subsection Material model
  set Model name = realistic composite
  subsection Diffusion dislocation
    set Reference temperature         = 500
    set Thermal diffusivity           = 1e-6
    set Heat capacity                 = 1000
    set Densities                     = 3300
    set Thermal expansivities         = 3e-5
    set Prefactors for diffusion creep        = 3.428173e-28
    set Stress exponents for diffusion creep  = 1
    set Grain size exponents for diffusion creep = 3
    set Activation energies for diffusion creep = 99773.5452
    set Activation volumes for diffusion creep  = 0
    set Prefactors for dislocation creep        = 1.280082e-35
    set Stress exponents for dislocation creep  = 3
    set Activation energies for dislocation creep = 141345.8557
    set Activation volumes for dislocation creep  = 0
    set Grain size = 1e-3
    set Minimum strain rate = 1.4e-20
    set Minimum viscosity   = 2.368635e19
    set Maximum viscosity   = 2.368635e27
    set Maximum strain rate ratio iterations = 400
    set Define transition by depth instead of pressure = true
    set Phase transition depths              = background: 377000|638000
    set Phase transition widths              = background: 72500|72500
    set Phase transition temperatures        = background: 1000|1000
    set Phase transition Clapeyron slopes    = background: 3.004214e6|-3.004214e6
    set Phase transition density jumps       = 180.0018, 299.9997
  end
end

subsection Heating model
  set List of model names = constant heating, latent heat
  subsection Constant heating
    set Radiogenic heating rate = 1.189061e-12
  end
end

subsection Formulation
  set Formulation = Boussinesq approximation
end

subsection Mesh refinement
  set Initial global refinement          = 5
  set Initial adaptive refinement        = 2
  set Time steps between mesh refinement = 5
  set Strategy                           = temperature
  set Refinement fraction                = 0.2
  set Coarsening fraction                = 0.005
  set Minimum refinement level           = 5
end

subsection Postprocess
  set List of postprocessors = velocity statistics, temperature statistics, heat flux statistics, visualization
  subsection Visualization
    set Number of grouped files       = 0
    set Output format                 = vtu
    set Time between graphical output = 1e300
    set List of output variables = material properties
    subsection Material properties
      set List of material properties = viscosity, density
    end
  end
end

subsection Solver parameters
  subsection Stokes solver parameters
    set Linear solver tolerance = 1e-7
  end
  set Temperature solver tolerance = 1e-9
end
