# One-step test of the production settings (AMR on): checks the post-initial-
# refinement cell count and the MPI run.
include realistic.prm

set Additional shared libraries = build/librealistic_composite.so
set End time          = 1e12
set Maximum time step = 1e12
set Output directory  = output-prodtest

subsection Postprocess
  subsection Visualization
    set Time between graphical output = 1e13
  end
end
