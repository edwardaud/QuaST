# Short smoke test of realistic.prm: coarse, one adaptive level, two steps.
include realistic.prm

# must be in the top-level file: ASPECT scans the raw input text for it
set Additional shared libraries = build/librealistic_composite.so
set End time         = 2e13
set Maximum time step = 2e13
set Output directory = output-test

subsection Mesh refinement
  set Initial global refinement   = 3
  set Initial adaptive refinement = 0
  set Minimum refinement level    = 3
  set Time steps between mesh refinement = 0
end

subsection Postprocess
  subsection Visualization
    set Time between graphical output = 1e13
  end
end
